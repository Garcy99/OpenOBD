<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher icon for Android 6-7 (no adaptive icons): the same artwork on a rounded square. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/launcher_bg" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:drawable="@drawable/ic_launcher_foreground" android:left="-6dp" android:top="-6dp" android:right="-6dp" android:bottom="-6dp" />
</layer-list>
